#include <winver.h>

/*
 * IDI_APP=1 matches what main.c loads via
 * LoadIcon(hInstance, MAKEINTRESOURCE(IDI_APP)) for the window/tray.
 *
 * resources/icon.ico must exist before building -- an .svg can't be
 * a Win32 resource by itself, see resources/README.md for conversion.
 * Missing file makes windres fail with a clear error, which is better
 * than silently building an exe with no icon.
 */
#define IDI_APP 1
IDI_APP ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "casablanque-code"
            VALUE "FileDescription",  "UnderBuffer -- clipboard cleanup daemon"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "underbuffer"
            VALUE "OriginalFilename", "underbuffer.exe"
            VALUE "ProductName",      "UnderBuffer"
            VALUE "ProductVersion",   "0.1.0.0"
            VALUE "LegalCopyright",   "casablanque-code"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
