#include <winver.h>

/*
 * Иконка. IDI_APP=1 -- тот же ID, что main.c грузит через
 * LoadIcon(hInstance, MAKEINTRESOURCE(IDI_APP)) для окна и трея.
 *
 * resources/icon.ico ДОЛЖЕН существовать до сборки -- .svg сам по
 * себе Win32-ресурсом быть не может, см. resources/README.md про
 * конвертацию. Если файла нет, windres просто упадёт с понятной
 * ошибкой "cannot open file" -- это ожидаемо и лучше, чем тихо
 * собрать exe без иконки.
 */
#define IDI_APP 1
IDI_APP ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "casablanque-code"
            VALUE "FileDescription",  "UnderBuffer -- clipboard cleanup daemon"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "underbuffer"
            VALUE "OriginalFilename", "underbuffer.exe"
            VALUE "ProductName",      "UnderBuffer"
            VALUE "ProductVersion",   "0.1.0.0"
            VALUE "LegalCopyright",   "casablanque-code"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
